# Fill in real values, then `make encrypt` -- see terraform/secrets.tf and
# Tech/Homelab/planning/aws-idc-pim-2026-11-20.md.
#
# discord_public_key:     Discord Developer Portal -> your app -> General Information -> Public Key.
#                          Needs the Function URL (terraform output function_url) to register the
#                          Interactions Endpoint URL first, so this is a chicken-and-egg: apply once
#                          with placeholder values to get the URL, register the Discord app, then
#                          re-encrypt with the real values and re-apply.
# discord_application_id: Discord Developer Portal -> your app -> General Information -> Application ID.
# discord_bot_token:      Discord Developer Portal -> your app -> Bot -> Token (Reset Token if needed).
#                          Only used for the standalone auto-revoke notification (discord_api.channel_message);
#                          the interaction response/followup path doesn't need it.
discord_public_key: "placeholder"
discord_application_id: "placeholder"
discord_bot_token: "placeholder"
